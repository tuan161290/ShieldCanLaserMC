<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ShieldCanLaser.TeachingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ShieldCanLaser">

    <!-- Trang Teaching — máy Laser Marking: quản lý model, tham số chu trình Auto, jog 3 trục (X, Y, Z) và điểm teach
         (PLAN-LASER.md §3): tab Pick (mỗi tray teach hàng 1 + hàng cuối: X, Y, Z — các hàng giữa chia đều), tab CAM
         (nozzle 1 + nozzle 7 giữa khung CAM: X, Z — N2…N6 chia đều), tab Laser (nozzle 1 + nozzle 7 ở tâm trường laser:
         X, Z — N2…N6 chia đều) và tab Others (điểm có tên tự thêm, mỗi điểm lưu vị trí của những trục được chọn).
         Danh sách model, danh sách điểm, các dòng jog, khung đầu/cuối và bảng chia đều dựng trong code (TeachingPage.xaml.cpp). -->
    <UserControl.Resources>
        <!-- Khung danh sách = lớp Control (nền trắng, viền mảnh, bo 4) như ListBox của bản WPF. -->
        <Style x:Key="ListFrameStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ControlFillBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <!-- Tab của card Điểm teach: nút dẹt, tab đang chọn tô accent (ui::SetTint). -->
        <Style x:Key="TeachTabStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <!-- Chọn tray: ô vuông số to, ô đang chọn tô accent. -->
        <Style x:Key="SelChipStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="WhenTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Loaded="OnRootLoaded">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="440"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════ Cột trái: Model + Jog + Tham số (cuộn được), dòng nhắc Status.Message ghim ở đáy ══════════ -->
        <Grid Grid.Column="0" Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- ══ Model ══ -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="0" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource CardHeaderStyle}">
                                <TextBlock Text="Model" Style="{StaticResource SectionHeaderStyle}"/>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource DividerStyle}"/>
                            <StackPanel Grid.Row="2" Margin="12">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="In use:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="CurrentModelText" FontSize="13" FontWeight="SemiBold" Margin="4,0,0,0"/>
                                </StackPanel>

                                <Border Style="{StaticResource ListFrameStyle}" Height="110" Margin="0,0,0,8">
                                    <ListView x:Name="ModelList" SelectionMode="Single"
                                              SelectionChanged="OnModelSelectionChanged"/>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="LOAD" Width="80" Margin="0,0,8,0" Click="OnLoadModelClick"/>
                                    <Button Content="SAVE" Width="80" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}"
                                            Click="OnSaveModelClick"/>
                                    <Button Content="DELETE" Width="80" Click="OnDeleteModelClick"/>
                                </StackPanel>

                                <Border Style="{StaticResource CardDividerStyle}"/>

                                <TextBlock Text="Description" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"/>
                                <TextBox x:Name="DescriptionBox" Margin="0,0,0,8" LostFocus="OnDescriptionLostFocus"
                                         ToolTipService.ToolTip="Free text saved with the model (product name, laser program, notes…)"/>

                                <TextBlock Text="New model name" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"/>
                                <TextBox x:Name="NewModelNameBox" Margin="0,0,0,8"
                                         ToolTipService.ToolTip="New model name — used by NEW and COPY (COPY copies the model selected above)"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="NEW" Width="100" Margin="0,0,8,0" Click="OnNewModelClick"/>
                                    <Button Content="COPY" Width="200" Click="OnCopyModelClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ══ Jog trục ══ — Chậm/Nhanh CHUNG cho cả 3 trục (McFunction::JogFast); nút đang chọn tô accent. -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource CardHeaderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Jog Axes" Style="{StaticResource SectionHeaderStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="JogSlowButton" Content="SLOW" Width="68" Height="28" MinHeight="28"
                                                Padding="6,0" FontSize="13" Margin="0,0,4,0" Click="OnJogSlowClick"/>
                                        <Button x:Name="JogFastButton" Content="FAST" Width="68" Height="28" MinHeight="28"
                                                Padding="6,0" FontSize="13" Click="OnJogFastClick"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource DividerStyle}"/>
                            <StackPanel Grid.Row="2" Margin="12">
                                <!-- Một dòng mỗi trục: tên, toạ độ, Jog −/+ (giữ để chạy, nhả là dừng), đèn ORG. -->
                                <StackPanel x:Name="JogRows" Margin="0,-6,0,0"/>
                                <Button Content="STOP ALL" HorizontalAlignment="Stretch" Margin="0,12,0,0" Click="OnStopAllClick"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ══ Tham số chu trình ══ — ModelData::Auto, lưu cùng model bằng nút SAVE ở card Model. Toạ độ trục nằm ở
                         các điểm teach bên phải. -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="0" Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource CardHeaderStyle}">
                                <TextBlock Text="Cycle Parameters" Style="{StaticResource SectionHeaderStyle}"/>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource DividerStyle}"/>
                            <StackPanel Grid.Row="2" Margin="12">
                                <TextBlock Style="{StaticResource HintStyle}" Margin="0,0,0,8"
                                           Text="Saved with the model (press SAVE, Model card). One cycle = one tray row of 7 cans picked by the 7 nozzles."/>
                                <Grid ColumnSpacing="12" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Rows per tray" Style="{StaticResource CaptionStyle}"/>
                                        <TextBox x:Name="AutoTrayRowsBox" LostFocus="OnAutoParamLostFocus"
                                                 ToolTipService.ToolTip="Number of rows in each tray (columns are fixed = 7 nozzles). Rows between Row 1 and Last row are interpolated (Pick tab)."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Final slow descent (mm)" Style="{StaticResource CaptionStyle}"/>
                                        <TextBox x:Name="AutoSlowLengthBox" LostFocus="OnAutoParamLostFocus"
                                                 ToolTipService.ToolTip="Last stretch before the pick / return Z height runs at low Auto speed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1">
                                        <TextBlock Text="Vacuum on delay (ms)" Style="{StaticResource CaptionStyle}"/>
                                        <TextBox x:Name="AutoVacuumOnBox" LostFocus="OnAutoParamLostFocus"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBlock Text="Vacuum off delay (ms)" Style="{StaticResource CaptionStyle}"/>
                                        <TextBox x:Name="AutoVacuumOffBox" LostFocus="OnAutoParamLostFocus"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2">
                                        <TextBlock Text="Laser mark time (ms)" Style="{StaticResource CaptionStyle}"/>
                                        <TextBox x:Name="AutoMarkTimeBox" LostFocus="OnAutoParamLostFocus"
                                                 ToolTipService.ToolTip="The laser trigger output stays ON this long per can — the laser does not report completion, so set it to the marking time of this model's content"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="AutoVisionCheck" Content="CAM step (measure can offset, compensate X/Z at laser)" Margin="0,8,0,0"
                                          Click="OnAutoFlagClick"/>
                                <CheckBox x:Name="AutoLaserCheck" Content="Fire laser (off = dry run: visit every point, no trigger)" Click="OnAutoFlagClick"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="MessageBar" Grid.Row="1" Style="{StaticResource InfoBarWarningStyle}" Margin="0,8,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource InfoBarWarningIconStyle}"/>
                    <TextBlock x:Name="MessageText" Grid.Column="1" Style="{StaticResource InfoBarTextStyle}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════ Điểm teach ══════════ — 4 tab. Pick: mỗi tray teach HÀNG 1 và HÀNG CUỐI (X, Y, Z — nozzle 1 đúng trên
             cột 1), các hàng giữa chia đều. CAM: nozzle 1 và nozzle 7 giữa khung CAM (X, Z), N2…N6 chia đều. Laser: nozzle 1 và
             nozzle 7 ở tâm trường laser (X, Z), N2…N6 chia đều (trim từng nozzle cộng thêm ở Vision Edit). Others: điểm tự thêm.
             Khung đầu/cuối và bảng chia đều dựng trong code. -->
        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardHeaderStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Teach Points" Style="{StaticResource SectionHeaderStyle}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="TabButton0" Tag="0" Content="Pick" Style="{StaticResource TeachTabStyle}" Click="OnTabClick"/>
                            <Button x:Name="TabButton1" Tag="1" Content="CAM" Style="{StaticResource TeachTabStyle}" Click="OnTabClick"/>
                            <Button x:Name="TabButton2" Tag="2" Content="Laser" Style="{StaticResource TeachTabStyle}" Click="OnTabClick"/>
                            <Button x:Name="TabButton3" Tag="3" Content="Others" Style="{StaticResource TeachTabStyle}" Click="OnTabClick"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource DividerStyle}"/>

                <Grid Grid.Row="2">
                    <!-- ── Pick / CAM / Laser: điểm đầu | điểm cuối → các điểm chia đều ── -->
                    <ScrollViewer x:Name="LayoutPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,12,20,16">
                            <!-- Chỉ tab Pick: chọn tray. -->
                            <StackPanel x:Name="SelectorPanel" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Tray" Style="{StaticResource FieldLabelStyle}" Width="40"/>
                                <Button x:Name="SelButton1" Tag="1" Content="1" Style="{StaticResource SelChipStyle}" Click="OnSelectorClick"/>
                                <Button x:Name="SelButton2" Tag="2" Content="2" Style="{StaticResource SelChipStyle}" Click="OnSelectorClick"/>
                                <TextBlock x:Name="SelectorHint" Style="{StaticResource HintStyle}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="LayoutHint" Style="{StaticResource HintStyle}" Margin="0,8,0,0"/>

                            <Border Style="{StaticResource InsetDividerStyle}" Margin="0,12"/>

                            <!-- Hai cột đầu / cuối ngăn bằng đường kẻ dọc. Mỗi cột: tên + lúc teach, các trục (sửa tay được),
                                 TEACH (lấy vị trí hiện tại của các trục đó) và MOVE TO (bấm đúp). -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <TextBlock x:Name="FirstTitle" Text="Row 1" Style="{StaticResource SubHeaderStyle}" Margin="0"/>
                                        <TextBlock x:Name="FirstWhen" Style="{StaticResource WhenTextStyle}"/>
                                    </Grid>
                                    <Grid x:Name="FirstAxes" RowSpacing="6" ColumnSpacing="8"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                        <Button Tag="0" Content="TEACH" Width="110" Style="{StaticResource PrimaryButton}" Click="OnEndTeachClick"
                                                ToolTipService.ToolTip="Store the current position of the axes above in this point"/>
                                        <Button Tag="0" Content="MOVE TO" Width="110" DoubleTapped="OnEndMoveDoubleTapped"
                                                ToolTipService.ToolTip="Double-click: raise Z to safe, move the point's axes at low Auto speed, lower Z last"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource VerticalDividerStyle}" Margin="20,0"/>
                                <StackPanel Grid.Column="2" Spacing="8">
                                    <Grid>
                                        <TextBlock x:Name="LastTitle" Text="Last row" Style="{StaticResource SubHeaderStyle}" Margin="0"/>
                                        <TextBlock x:Name="LastWhen" Style="{StaticResource WhenTextStyle}"/>
                                    </Grid>
                                    <Grid x:Name="LastAxes" RowSpacing="6" ColumnSpacing="8"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                        <Button Tag="1" Content="TEACH" Width="110" Style="{StaticResource PrimaryButton}" Click="OnEndTeachClick"
                                                ToolTipService.ToolTip="Store the current position of the axes above in this point"/>
                                        <Button Tag="1" Content="MOVE TO" Width="110" DoubleTapped="OnEndMoveDoubleTapped"
                                                ToolTipService.ToolTip="Double-click: raise Z to safe, move the point's axes at low Auto speed, lower Z last"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource InsetDividerStyle}" Margin="0,12"/>
                            <Grid>
                                <TextBlock x:Name="DerivedTitle" Text="Interpolated Points" Style="{StaticResource SubHeaderStyle}" Margin="0"/>
                                <TextBlock x:Name="DerivedHint" Style="{StaticResource WhenTextStyle}"/>
                            </Grid>
                            <!-- Bảng: số thứ tự, toạ độ từng trục, MOVE TO (bấm đúp). Dựng lại khi đổi tab/tray/số hàng/teach. -->
                            <StackPanel x:Name="DerivedRows" Margin="0,6,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── Others: danh sách điểm có tên + chi tiết điểm đang chọn ── -->
                    <Grid x:Name="OtherPanel" Margin="12" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Danh sách điểm + thêm/xoá điểm -->
                        <Grid Grid.Column="0" Margin="0,0,12,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource ListFrameStyle}">
                                <Grid>
                                    <ListView x:Name="PointList" SelectionMode="Single" SelectionChanged="OnPointSelectionChanged"/>
                                    <!-- Danh sách trống: vị trí chờ là StandbyPos từng trục ở Setting, không phải điểm teach. -->
                                    <TextBlock x:Name="PointListEmptyText" Style="{StaticResource HintStyle}" Margin="14,12" Visibility="Collapsed"
                                               Text="No custom points. The cycle only uses the Pick / CAM / Laser tabs; the standby position is each axis's StandbyPos (Setting). Add points here for manual MOVE TO if needed."/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                <TextBox x:Name="NewPointNameBox" Margin="0,0,0,8"
                                         ToolTipService.ToolTip="New point name — leave blank for Point1, Point2…"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="ADD POINT" Width="110" Margin="0,0,8,0" Click="OnAddPointClick"/>
                                    <Button x:Name="DeletePointButton" Content="DEL POINT" Width="110" Click="OnDeletePointClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Column="1" Style="{StaticResource VerticalDividerStyle}" Margin="0,-12,0,-12"/>

                        <!-- Chi tiết điểm đang chọn — ẩn khi chưa chọn điểm nào. -->
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Margin="16,0,0,0">
                            <StackPanel x:Name="Editor" Padding="0,0,12,0" Visibility="Collapsed">
                                <!-- Tên + Ghi chú: hai ô cạnh nhau, hẹp quá thì Ghi chú xuống dòng (WrapFlow). -->
                                <StackPanel x:Name="FieldsWrap" Spacing="8">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel x:Name="NameField" Width="200" Margin="0,0,16,0">
                                            <TextBlock Text="Point name" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="PointNameBox" LostFocus="OnPointNameLostFocus"/>
                                        </StackPanel>
                                        <StackPanel x:Name="NoteField" Width="320">
                                            <TextBlock Text="Note" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="PointNoteBox" LostFocus="OnPointNoteLostFocus"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <Border Style="{StaticResource InsetDividerStyle}" Margin="0,12,0,4"/>

                                <!-- Một hàng mỗi trục: dùng/không, toạ độ (sửa tay được), lấy vị trí hiện tại. Dựng trong code. -->
                                <StackPanel x:Name="AxisRows"/>

                                <StackPanel x:Name="ButtonsWrap" Margin="0,16,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="TeachButton" Content="TEACH" Width="200" Margin="0,0,8,8"
                                                Style="{StaticResource PrimaryButton}" Click="OnTeachClick"
                                                ToolTipService.ToolTip="Store the current position of all checked axes. If no axis is checked, all 3 axes are stored."/>
                                        <!-- Bấm đúp mới chạy (bản WPF nuốt cú nhấp đơn ở PreviewMouseLeftButtonDown). -->
                                        <Button x:Name="MoveButton" Content="MOVE TO" Width="110" Margin="0,0,8,8"
                                                DoubleTapped="OnMoveDoubleTapped"
                                                ToolTipService.ToolTip="Double-click: raise Z to safe, move the point's axes at high Auto speed, lower Z last."/>
                                        <Button x:Name="MoveSlowButton" Content="MOVE SLOW" Width="140" Margin="0,0,8,8"
                                                DoubleTapped="OnMoveSlowDoubleTapped"
                                                ToolTipService.ToolTip="Double-click: like MOVE TO but at low Auto speed — use when first trying a new point."/>
                                        <Button x:Name="StopButton" Content="STOP" Width="90" Margin="0,0,8,8" Click="OnStopAllClick"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

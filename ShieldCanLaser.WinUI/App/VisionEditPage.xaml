<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ShieldCanLaser.VisionEditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ShieldCanLaser">

    <!-- Trang Vision Edit — máy Laser Marking: thanh jog 3 trục, khung chỉnh Flow của VisionMaster (trái) và cột thử (phải,
         PLAN-LASER.md §4). Vision chỉ kiểm tra sau khi khắc, không hiệu chuẩn camera. Cột thử: chọn nozzle → chọn bước trên
         thanh bước ngang → khung của bước → một dòng kết quả ở đáy. Hai bước: Thử khắc (tới điểm khắc, TEST MARK, trim) và
         Kiểm tra (tới CAM, chạy Flow, xem Result). Giải thích dài nằm trong tooltip. Mọi nút làm trục chạy / kích laser: BẤM
         ĐÚP (như cả app). -->
    <UserControl.Resources>
        <!-- Một ô của thanh bước ngang: nền trong suốt (vạch nối các vòng số lộ ra), ô đang chọn tô nhạt. -->
        <Style x:Key="StepTabStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,6,0,6"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
        <Style x:Key="StepLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <!-- Nút chọn nozzle: vuông bo tròn, số to; chấm trạng thái ở góc. 7 nút (38 px, cách 4) phải vừa cột 404 px. -->
        <Style x:Key="NozzleChipStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style x:Key="NumBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Width" Value="76"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="FieldTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="StepTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <!-- Vòng số của thanh bước — nền đặc để che vạch nối phía sau. -->
        <Style x:Key="StepBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeSecondaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource ControlFillBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StepBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style x:Key="StepStatusStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Loaded="OnRootLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="404"/>
        </Grid.ColumnDefinitions>

        <!-- Thanh Jog 3 trục X, Y, Z (một hàng). Không hiện toạ độ: thanh tiêu đề cửa sổ đã có. -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8" Padding="16,8">
            <Grid HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Vision Edit" FontSize="20" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Border Grid.Column="1" Style="{StaticResource VerticalDividerStyle}" Margin="0,-8,16,-8"/>

                <!-- Jog −/+ giữ để chạy, nhả là dừng (ui::AttachJog). Dựng trong code theo AxisId::All / GridSlot. -->
                <Grid x:Name="JogGrid" Grid.Column="2" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                </Grid>

                <Border Grid.Column="3" Style="{StaticResource VerticalDividerStyle}" Margin="4,-8,16,-8"/>

                <Button x:Name="ZSafeButton" Grid.Column="4" Content="Z SAFE" Width="110" Margin="0,0,16,0"
                        VerticalAlignment="Center" DoubleTapped="OnZSafeDoubleTapped"
                        ToolTipService.ToolTip="Double-click: raise Z to safe height"/>

                <!-- Chậm/Nhanh chung cho mọi trục và mọi trang (McFunction::JogFast). -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0" Spacing="4">
                    <Button x:Name="JogSlowButton" Content="SLOW" Width="80" Click="OnJogSlowClick"/>
                    <Button x:Name="JogFastButton" Content="FAST" Width="80" Click="OnJogFastClick"/>
                </StackPanel>

                <Border Grid.Column="6" Style="{StaticResource VerticalDividerStyle}" Margin="0,-8,16,-8"/>

                <!-- STOP không khoá theo Busy — dừng được cả khi bước hiệu chuẩn đang chạy trục. -->
                <Button Grid.Column="7" Content="STOP" Width="96" Height="44" FontSize="16" FontWeight="Bold"
                        VerticalAlignment="Center" Click="OnStopAllClick"
                        Background="{StaticResource RedOnBrush}" BorderBrush="{StaticResource RedOnBrush}"
                        Foreground="{StaticResource TextOnAccentBrush}"
                        ToolTipService.ToolTip="Stop all axes immediately — same as STOP ALL on Manual page"/>
            </Grid>
        </Border>

        <!-- Khung VisionMaster: thanh công cụ SDK + trạng thái solution | thông báo (khi có) | đường kẻ | vùng chỉnh Flow. -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="2" Margin="0,0,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto" MaxWidth="320"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="GlobalToolHost" Height="40" Margin="4,2,4,2"/>
                    <Ellipse x:Name="SolutionLamp" Grid.Column="1" Width="10" Height="10" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SolutionText" Grid.Column="2" FontSize="13" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="3" Width="36" Padding="0" Margin="0,0,6,0" VerticalAlignment="Center" Click="OnReloadSolutionClick"
                            ToolTipService.ToolTip="Reload the .solw file from the path on Setting page">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                    </Button>
                </Grid>
                <Border x:Name="MessageBar" Grid.Row="1" Style="{StaticResource InfoBarWarningStyle}" Padding="10,6" Margin="6,0,6,6"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Style="{StaticResource InfoBarWarningIconStyle}"/>
                        <TextBlock x:Name="MessageText" Grid.Column="1" Style="{StaticResource InfoBarTextStyle}" FontSize="12"/>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource DividerStyle}" Margin="-2,0,-2,0"/>
                <Grid Grid.Row="3">
                    <Border x:Name="ConfigHost"/>
                    <TextBlock x:Name="VmPlaceholderText" Style="{StaticResource HintStyle}" Margin="24"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="560"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ══════════ Cột phải: thử khắc và kiểm tra ══════════ -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardHeaderStyle}">
                    <TextBlock Text="Laser &amp; Inspection Trial" Style="{StaticResource SectionHeaderStyle}"/>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource DividerStyle}"/>

                <!-- Chọn nozzle (chấm: xanh = lần kiểm tra gần nhất OK, đỏ = NG, xám = chưa kiểm tra) + thanh bước ngang. -->
                <StackPanel x:Name="NavPanel" Grid.Row="2" Margin="12,10,12,6" Spacing="8">
                    <StackPanel x:Name="NozzleRow" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Nozzle" Style="{StaticResource FieldTextStyle}" Width="42"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <!-- Vạch nối tâm vòng đầu tới tâm vòng cuối (1/4 bề rộng mỗi bên); nằm sau các nút. -->
                        <Grid Grid.ColumnSpan="2" VerticalAlignment="Top" Margin="0,19,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="1" Height="1" Background="{StaticResource ControlStrokeSecondaryBrush}"/>
                        </Grid>
                        <Button x:Name="StepButton0" Grid.Column="0" Tag="0" Style="{StaticResource StepTabStyle}" Click="OnStepClick">
                            <StackPanel Spacing="4">
                                <Border x:Name="StepBadge0" Style="{StaticResource StepBadgeStyle}"><TextBlock x:Name="StepBadgeText0" Text="1" Style="{StaticResource StepBadgeTextStyle}"/></Border>
                                <TextBlock x:Name="StepLabel0" Text="Laser trial" Style="{StaticResource StepLabelStyle}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="StepButton1" Grid.Column="1" Tag="1" Style="{StaticResource StepTabStyle}" Click="OnStepClick">
                            <StackPanel Spacing="4">
                                <Border x:Name="StepBadge1" Style="{StaticResource StepBadgeStyle}"><TextBlock x:Name="StepBadgeText1" Text="2" Style="{StaticResource StepBadgeTextStyle}"/></Border>
                                <TextBlock x:Name="StepLabel1" Text="Inspection" Style="{StaticResource StepLabelStyle}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
                <Border Grid.Row="3" Style="{StaticResource DividerStyle}"/>

                <!-- ══ Khung của bước đang chọn ══ -->
                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="StepHost" Margin="12,10,18,12">

                        <!-- 1 · Thử khắc (nozzle đang chọn): điểm Laser(k) + trim, không bù độ lệch can -->
                        <StackPanel x:Name="StepPanel0" Spacing="10">
                            <Grid ColumnSpacing="8">
                                <TextBlock x:Name="LaserTitle" Text="Laser trial · nozzle 1" Style="{StaticResource StepTitleStyle}"/>
                                <TextBlock x:Name="StepStatus0" Style="{StaticResource StepStatusStyle}"/>
                            </Grid>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Content="GO TO LASER" HorizontalAlignment="Stretch" DoubleTapped="OnGoToLaserDoubleTapped"
                                        ToolTipService.ToolTip="Double-click: X/Z to the Laser point of this nozzle + trim. Does not fire."/>
                                <Button Grid.Column="1" Content="TEST MARK" HorizontalAlignment="Stretch" DoubleTapped="OnTestMarkDoubleTapped"
                                        ToolTipService.ToolTip="Double-click: pulse the laser start output here for MarkTimeMs (model)"/>
                            </Grid>
                            <TextBlock x:Name="LaserStatusText" Style="{StaticResource ValueTextStyle}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Border Style="{StaticResource InsetDividerStyle}" Margin="0,2"/>
                            <TextBlock Text="Trim (model)" Style="{StaticResource SubHeaderStyle}" Margin="0"/>
                            <Grid ColumnSpacing="6" RowSpacing="4">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="X mm" Style="{StaticResource FieldTextStyle}" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="Z mm" Style="{StaticResource FieldTextStyle}" FontSize="12"/>
                                <TextBox x:Name="TrimXBox" Grid.Row="1" Style="{StaticResource NumBoxStyle}" Width="Auto"/>
                                <TextBox x:Name="TrimZBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource NumBoxStyle}" Width="Auto"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="APPLY" Click="OnApplyTrimClick"
                                        ToolTipService.ToolTip="Offset added to the Laser point of this nozzle; max ±1 mm. Saved to the model."/>
                            </Grid>
                            <Border Style="{StaticResource InsetDividerStyle}" Margin="0,2"/>
                            <TextBlock Text="All nozzles" Style="{StaticResource SubHeaderStyle}" Margin="0"/>
                            <!-- 7 dòng: N · trim · kết quả kiểm tra gần nhất — dựng trong code. -->
                            <StackPanel x:Name="NozzleSummary" Spacing="2"/>
                        </StackPanel>

                        <!-- 2 · Kiểm tra (nozzle đang chọn): tới CAM, chạy Flow, đọc Result của Group -->
                        <StackPanel x:Name="StepPanel1" Spacing="10" Visibility="Collapsed">
                            <Grid ColumnSpacing="8">
                                <TextBlock x:Name="InspectTitle" Text="Inspection · nozzle 1" Style="{StaticResource StepTitleStyle}"/>
                                <TextBlock x:Name="StepStatus1" Style="{StaticResource StepStatusStyle}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource HintStyle}" Margin="0"
                                       Text="Vacuum a marked can onto the nozzle (Manual page). INSPECT runs the Flow and reads Result of the Group: 1 = OK, anything else = NG."/>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Content="GO TO CAM" HorizontalAlignment="Stretch" DoubleTapped="OnGoToCamDoubleTapped"
                                        ToolTipService.ToolTip="Double-click: X/Z to the CAM point of this nozzle (interpolated from CAM · N1 / N7)"/>
                                <Button Grid.Column="1" Content="INSPECT" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Click="OnInspectClick"
                                        ToolTipService.ToolTip="Run the inspection Flow here (CAM light on) and read Result of the Group"/>
                            </Grid>
                            <TextBlock x:Name="InspectPathText" Style="{StaticResource ValueTextStyle}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="LastInspectText" Style="{StaticResource ValueTextStyle}"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- ══ Dòng kết quả của nút vừa bấm ══ -->
                <Border Grid.Row="5" Style="{StaticResource DividerStyle}"/>
                <Grid x:Name="ResultBar" Grid.Row="6" Padding="12,10" ColumnSpacing="10" MinHeight="48">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Top" Margin="0,1,0,0">
                        <FontIcon x:Name="ResultIcon" Glyph="&#xE946;" FontSize="16" Foreground="{StaticResource TextTertiaryBrush}"/>
                        <ProgressRing x:Name="BusyRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed"/>
                    </Grid>
                    <TextBlock x:Name="ResultText" Grid.Column="1" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Foreground="{StaticResource TextSecondaryBrush}" Text="Select nozzle and step. Axis-moving buttons: double-click."/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

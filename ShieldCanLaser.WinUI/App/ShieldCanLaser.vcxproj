  <PropertyGroup>
    <!-- ScsRoot / ScsBuildDir (không có dấu \ cuối): build một BẢN SAO của thư mục App ở nơi khác mà vẫn dùng
         Core, ThirdParty và thư viện đã build của cây chính — xem tools\build-app-copy.ps1. -->
    <RootDir Condition="'$(ScsRoot)'!=''">$(ScsRoot)\</RootDir>
    <RootDir Condition="'$(ScsRoot)'==''">$(MSBuildThisFileDirectory)..\</RootDir>
    <AppBuildDir Condition="'$(ScsBuildDir)'!=''">$(ScsBuildDir)\</AppBuildDir>
    <AppBuildDir Condition="'$(ScsBuildDir)'==''">$(RootDir)build\</AppBuildDir>
    <SoemDir>$(RootDir)ThirdParty\soem\</SoemDir>
    <OutDir>$(AppBuildDir)$(Platform)\$(Configuration)\App\</OutDir>
    <IntDir>$(AppBuildDir)obj\$(Platform)\$(Configuration)\App\</IntDir>
    <GenerateManifest>true</GenerateManifest>
    <EmbedManifest>true</EmbedManifest>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <PrecompiledHeaderOutputFile>$(IntDir)pch.pch</PrecompiledHeaderOutputFile>
      <WarningLevel>Level3</WarningLevel>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <!-- /EHs: hàm xuất của SDK VM khai báo extern "C" nhưng vẫn ném CVmException; với /EHsc trình
           biên dịch bỏ luôn khối catch quanh các lời gọi đó -->
      <ExceptionHandling>SyncCThrow</ExceptionHandling>
      <AdditionalOptions>%(AdditionalOptions) /utf-8 /bigobj</AdditionalOptions>
      <!-- ATL bị tắt cứng với ApplicationType=Windows Store, nên tự thêm đường dẫn atlmfc + atls.lib -->
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory);$(RootDir)Core;$(RootDir)ThirdParty;$(VCToolsInstallDir)atlmfc\include;$(VmSdkRoot)\Includes;$(VmSdkRoot)\ComControls\Includes\VS2017;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>NOMINMAX;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <DisableSpecificWarnings>4819;4828;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <!-- /Z7: debug info nằm trong .obj, không có vc145.pdb dùng chung lúc biên dịch. Thư mục build nằm
           trong vùng đồng bộ OwnCloud; file .pdb bị nhiều cl.exe và trình đồng bộ cùng mở là nguồn lỗi C1041. -->
      <DebugInformationFormat>OldStyle</DebugInformationFormat>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateWindowsMetadata>false</GenerateWindowsMetadata>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>atls.lib;iMVS-6000PlatformSDK.lib;wpcap.lib;Packet.lib;ws2_32.lib;winmm.lib;iphlpapi.lib;gdiplus.lib;dwmapi.lib;psapi.lib;delayimp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(VCToolsInstallDir)atlmfc\lib\x64;$(VmSdkRoot)\Libraries\win64\C;$(SoemDir)oshw\win32\wpcap\Lib\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <!-- Nạp trễ: máy chưa cài Npcap hoặc VisionMaster vẫn mở được app ở chế độ mô phỏng; chọn phần
           cứng thật mà thiếu thì alarm nói rõ (không bao giờ âm thầm rơi về mô phỏng). -->
      <DelayLoadDLLs>wpcap.dll;Packet.dll;iMVS-6000PlatformSDK.dll;%(DelayLoadDLLs)</DelayLoadDLLs>
      <AdditionalOptions>%(AdditionalOptions) /IGNORE:4199</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
  <!--
    Dữ liệu chạy cạnh exe:
      Config\alarms.json  bản mẫu bảng mã alarm (AlarmCatalog rơi về đây khi %APP_PATH%\Config chưa có)
      DriverInfo\**       ESI của driver/bộ ghép — bề rộng bit từng module trong rack R1EC và tên driver cho nút Scan
  -->
  <Target Name="CopyRuntimeData" AfterTargets="Build">
    <ItemGroup>
      <_AlarmTable Include="$(RootDir)..\Config\alarms.json" />
      <_DriverInfo Include="$(RootDir)DriverInfo\**\*.xml" />
    </ItemGroup>
    <Copy SourceFiles="@(_AlarmTable)" DestinationFolder="$(OutDir)Config" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_DriverInfo)" DestinationFolder="$(OutDir)DriverInfo\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
